  },
  "changedVariable": {
    "providerTransportStrategy": "semanticJsonV29",
    "providerTransportSchema": "workout-import-provider-transport-semantic-json/v2.9",
    "envelopeProjection": "oneStrictStringContainingCanonicalSemanticV2JSON",
    "schemaProfile": "googleGeminiMinimalV29"
  },
  "unchangedInputs": {
    "prompt": "workout-import-prompt/v2",
    "developmentExamples": "workout-import-development/v2",
    "hostSemanticSchema": "workout-import-model-output/v2",
    "normalisedResultEnvelope": "workout-import-result/v1",
    "deterministicScorer": "workout-import-scorer/v1"
  },
  "reasoning": {
    "google/gemini-3.5-flash-lite": {"enabled": true, "effort": "minimal", "exclude": false},
    "google/gemini-3.7-flash": {"enabled": true, "effort": "medium", "exclude": false}
  },
  "execution": {
    "globalConcurrency": 1,
    "minimumInterCallDelaySeconds": 2,
    "automaticRetries": 0,
    "httpConnectRetries": 0,
    "connectTimeoutSeconds": 15,
    "attemptTimeoutSeconds": 180,
    "cancelFlushSeconds": 15,
    "cache": false,
    "cachePrompt": false,
    "resumable": false
