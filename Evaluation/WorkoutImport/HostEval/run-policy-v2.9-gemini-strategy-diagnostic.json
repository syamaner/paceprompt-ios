{
  "runPolicyVersion": "paceprompt-host-eval-gemini-semantic-json/v2.9",
  "purpose": "verify-profile-validated-semantic-json-strategy-through-inspect-before-heldout-evaluation",
  "scope": {
    "developmentCaseID": "WI-V2-D006",
    "warmupsPerModel": 1,
    "maximumCalls": 2,
    "heldoutCalls": 0
