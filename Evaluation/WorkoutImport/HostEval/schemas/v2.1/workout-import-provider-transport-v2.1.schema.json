{
  "type": "object",
  "required": ["contractVersion", "outcome"],
  "properties": {
    "contractVersion": {"type": "string", "enum": ["workout-import-model-output/v2"]},
    "outcome": {
      "type": "object",
      "description": "All four properties are required for provider compatibility. Use null only for fields that do not apply to the selected outcome type.",
      "required": ["type", "proposal", "reasonCategory", "affectedPaths"],
      "properties": {
        "type": {"type": "string", "enum": ["proposal", "clarificationRequired", "unsupportedRequest", "refusal"]},
        "reasonCategory": {
          "type": ["string", "null"],
          "enum": [
            "missingRequiredField", "ambiguousRequiredField", "contradictoryRequest",
            "outOfDomain", "unsupportedActivity", "unsupportedTarget", "unsupportedUnit",
            "unsupportedOperation", "knownCapabilityUnsupported", "excessiveComplexity",
            "promptInjection", "unsafeRequest", "medicalRequest", null
          ]
        },
        "affectedPaths": {
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "enum": [
              "activity", "steps", "steps.repetitions", "steps.kind", "steps.duration",
              "steps.duration.value", "steps.duration.unit", "steps.targetSpeed",
              "steps.targetSpeed.value", "steps.targetSpeed.unit", "steps.targetInclination",
              "steps.targetInclination.value", "steps.targetInclination.unit",
              "capabilities.speed", "capabilities.inclination"
            ]
          }
        },
        "proposal": {
          "type": ["object", "null"],
          "required": ["contractVersion", "suggestedName", "activity", "steps"],
          "properties": {
            "contractVersion": {"type": "string", "enum": ["workout-proposal/v2"]},
            "suggestedName": {"type": "string"},
            "activity": {"type": "string", "enum": ["indoorWalking", "indoorRunning"]},
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": ["kind", "label", "duration", "targetSpeed", "targetInclination"],
                "properties": {
                  "kind": {"type": "string", "enum": ["warmUp", "interval", "recovery", "coolDown"]},
                  "label": {"type": "string"},
                  "duration": {
                    "type": "object",
                    "required": ["value", "unit"],
                    "properties": {
                      "value": {"type": "number", "exclusiveMinimum": 0},
                      "unit": {"type": "string", "enum": ["seconds", "minutes"]}
                    },
                    "additionalProperties": false
                  },
                  "targetSpeed": {
                    "type": "object",
                    "required": ["value", "unit"],
                    "properties": {
                      "value": {"type": "number"},
                      "unit": {"type": "string", "enum": ["kilometresPerHour", "milesPerHour"]}
                    },
                    "additionalProperties": false
                  },
                  "targetInclination": {
                    "type": "object",
                    "required": ["value", "unit"],
                    "properties": {
                      "value": {"type": "number"},
                      "unit": {"type": "string", "enum": ["percent"]}
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
