{
  "runPolicyVersion": "paceprompt-host-eval-gemini-flat-envelope/v2.8",
  "purpose": "verify-flat-envelope-strategy-through-inspect-before-heldout-evaluation",
  "scope": {
    "developmentCaseID": "WI-V2-D006",
    "warmupsPerModel": 1,
    "maximumCalls": 2,
    "heldoutCalls": 0
  },
  "strategy": {
    "registry": "strategyRegistryV28",
    "selection": "closedExactRouteRegistry",
    "unknownRouteBehaviour": "failClosed",
    "google/gemini-3.5-flash-lite": "flatEnvelopeV28",
    "google/gemini-3.7-flash": "flatEnvelopeV28"
  },
  "changedVariable": {
    "providerTransportStrategy": "flatEnvelopeV28",
    "providerTransportSchema": "workout-import-provider-transport-flat-envelope/v2.8",
    "envelopeProjection": "flattenOutcomeProposalAndStepValueObjectsThenRebuildOnHost"
  },
  "unchangedInputs": {
    "prompt": "workout-import-prompt/v2",
    "developmentExamples": "workout-import-development/v2",
    "hostSemanticSchema": "workout-import-model-output/v2",
    "normalisedResultEnvelope": "workout-import-result/v1",
    "deterministicScorer": "workout-import-scorer/v1"
  },
  "reasoning": {
    "google/gemini-3.5-flash-lite": {"enabled": true, "effort": "minimal", "exclude": false},
    "google/gemini-3.7-flash": {"enabled": true, "effort": "medium", "exclude": false}
  },
  "execution": {
    "globalConcurrency": 1,
    "minimumInterCallDelaySeconds": 2,
    "automaticRetries": 0,
    "httpConnectRetries": 0,
    "connectTimeoutSeconds": 15,
    "attemptTimeoutSeconds": 180,
    "cancelFlushSeconds": 15,
    "cache": false,
    "cachePrompt": false,
    "resumable": false
  },
  "spending": {
    "currency": "USD",
    "hardLimit": "2.00",
    "enforcement": "worstCaseBeforeEveryCallPlusEndpointPriceCap"
  }
}
