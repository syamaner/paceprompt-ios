{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/shared/AppFrame/**",
              "components/shared/ConnectionIndicator/**",
              "components/shared/LiveCurve/**",
              "components/shared/VerdictBadge/**",
              "design_handoff_settings/settings/**",
              "settings/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:headerRight|children|className|key|ref|className|style|children)$/]",
        "message": "<AppFrame> doesn't accept that prop. Declared props: headerRight, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectionIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|className|key|ref|className|style|children)$/]",
        "message": "<ConnectionIndicator> doesn't accept that prop. Declared props: status, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectionIndicator'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:connecting|live|reconnecting|stale)$/]",
        "message": "<ConnectionIndicator> status must be one of 'connecting' | 'live' | 'reconnecting' | 'stale'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveCurve'] > JSXAttribute > JSXIdentifier[name!=/^(?:points|markers|phase|chargeBand|highlightTime|originSeconds|initialHidden|className|height|key|ref|className|style|children)$/]",
        "message": "<LiveCurve> doesn't accept that prop. Declared props: points, markers, phase, chargeBand, highlightTime, originSeconds, initialHidden, className, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveCurve'] > JSXAttribute[name.name='phase'] > Literal[value!=/^(?:idle|starting|preheating|roasting_pre_first_crack|development|cooling|complete|faulted|operator_recovery_required)$/]",
        "message": "<LiveCurve> phase must be one of 'idle' | 'starting' | 'preheating' | 'roasting_pre_first_crack' | 'development' | 'cooling' | 'complete' | 'faulted' | 'operator_recovery_required'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:verdict|className|key|ref|className|style|children)$/]",
        "message": "<VerdictBadge> doesn't accept that prop. Declared props: verdict, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictBadge'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:allow|clamp|reject|recovery|fault|emergency_stop)$/]",
        "message": "<VerdictBadge> verdict must be one of 'allow' | 'clamp' | 'reject' | 'recovery' | 'fault' | 'emergency_stop'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "AppFrame": {
        "replaces": []
      },
